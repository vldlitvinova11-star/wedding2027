        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 345 326" fill="none">
          <path d="M145.512 17.6695C156.416 26.3435 165.294 38.0856 173.625 52.9916C182.966 38.6963 192.634 27.5954 204.111 19.6949C218.668 9.67309 235.693 4.99892 257.966 5.76878C282.607 6.62046 304.657 16.6987 320.38 32.2964C336.245 48.0352 345.662 69.3574 344.862 92.5224C343.475 132.639 320.801 171.57 287.483 209.907C254.913 247.385 212.058 284.393 169.203 321.399L164.199 325.721L159.504 321.064C119.307 281.187 79.1094 241.309 49.2044 201.672C18.6134 161.125 -1.31889 120.721 0.067693 80.6049C0.868377 57.4397 11.7355 36.8186 28.6492 22.213C45.4116 7.73792 68.1052 -0.793367 92.7456 0.0583047C115.019 0.828176 131.68 6.66643 145.512 17.6695L145.512 17.6695Z" fill="#D32F2F"/>
        </svg>
