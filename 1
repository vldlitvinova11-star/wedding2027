      <!-- Names overlaid like in the reference -->
      <div class="hero-names">
        Дмитрий<br>
        <span class="amp">&</span><br>
        Владислава
      </div>
    </div>

    <p class="hero-subtitle">Приглашаем вас на нашу свадьбу</p>
    <div class="scroll-hint">↓</div>
  </header>

  <!-- INVITE TEXT -->
  <section>
    <div class="invite-text">
      <p class="greeting">Дорогие друзья и близкие!</p>
      <p>Мы с огромной радостью приглашаем вас разделить с нами этот особенный день и стать частью нашей семейной истории.</p>
      <p>Ваше присутствие сделает наш праздник ещё теплее и светлее.</p>
    </div>
  </section>

